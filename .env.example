# Copie para .env e ajuste. NUNCA commitar o .env real.

# --- Aplicação ---
APP_ENV=development            # development | test | production
APP_NAME="Job Agent"
LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR | CRITICAL
# Lista separada por vírgulas. Em production, "*" é rejeitado na inicialização.
CORS_ORIGINS=http://localhost:5173
# Usuário único do D1 (sem autenticação). Criado automaticamente na primeira requisição.
DEFAULT_USER_EMAIL=local@jobagent.local
DEFAULT_USER_NAME="Local User"

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=job_agent
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=job_agent
POSTGRES_PORT=5432

# --- Conexões usadas pelo backend ---
# O mesmo valor de POSTGRES_PASSWORD deve aparecer nas duas URLs.
DATABASE_URL=postgresql+psycopg://job_agent:change-me-locally@localhost:5432/job_agent
# Banco de testes: o NOME deve terminar em "_test" (guard do conftest).
TEST_DATABASE_URL=postgresql+psycopg://job_agent:change-me-locally@localhost:5432/job_agent_test
